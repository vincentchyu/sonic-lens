# 本地文件日志配置
log:
  path: ./.logs                                 # SonicLens 本地日志目录
  level: info                                   # debug / info / warn / error

# Cloudflare D1 同步配置示例
# 将此配置添加到你的 config/config.yaml 文件中

dashboard:
  statRefreshEnabled: true                      # 是否启用 dashboard 统计定时任务
  statRefreshIntervalMinutes: 10                # 统计刷新间隔(分钟)，默认10分钟
  heavyStatRefreshIntervalMinutes: 60           # 重型统计刷新间隔(分钟)，默认60分钟
  heavyStatOnlyOnNewPlay: true                  # 仅在有新播放记录时刷新 top_*/trend_*，默认 true
  topN: 10                                      # 统计榜单每类保留条数，默认10
  trendDays: 180                                # 趋势统计保留天数，默认180天
  hourlyTrendDays: 0                            # 小时趋势保留天数，<=0 表示跟随 trendDays（推荐）

telemetry:
  name: "sonic-lens"                            # OpenTelemetry service.name
  endpoint: "http://127.0.0.1:4317"             # SigNoz OTLP gRPC Collector 地址
  insecure: true                                # 本地 / 内网 collector 常见是明文 gRPC
  sampler: 1.0                                  # 生产可按需降到 0.1 / 0.2
  metricIntervalSeconds: 15                     # 指标导出周期
  runtimeMetricsEnabled: true                   # 采集 Go runtime 指标
  dbStatsMetricsEnabled: true                   # 采集 database/sql 连接池指标
  environment: "dev"                            # deployment.environment
  # 当前应用代码只直连 trace + metrics；日志建议继续写本地文件，
  # 再用 config/otelcol/filelog_signoz.yaml.example 的 filelog Collector 采集。
  # SigNoz 的日志 retention 请在管理端单独设置，例如 1 天；它与本地文件保留天数解耦。

cloudflare:
  account_id: "your_cloudflare_account_id"      # Cloudflare Account ID
  api_token: "your_cloudflare_api_token"        # Cloudflare API Token (需要 D1 权限)
  d1_database_id: "your_d1_database_id"         # D1 数据库 ID
  sync_enabled: true                            # 是否启用 D1 同步
  sync_interval: 24                             # 同步间隔(小时),默认 24 小时

# 对象存储配置（MinIO / S3 / R2）
objectStorage:
  enabled: false
  provider: "s3"
  endpoint: "http://127.0.0.1:9000"
  bucket: "album"
  region: "auto"
  accessKeyId: "admin"
  secretAccessKey: "change_me"
  cdnUrl: ""                                    # 可选，填写后优先返回 CDN 前缀地址
  basePrefix: "v1"
  originalPrefix: "originals/"
  thumbnailPrefix: "thumbnails/"
  forcePathStyle: true
  useSSL: false

# 也可通过环境变量覆盖（推荐生产环境）：
# ENDPOINT / BUCKET / REGION / ACCESS_KEY_ID / SECRET_ACCESS_KEY / CDN_URL
# BASE_PREFIX / ORIGINAL_PREFIX / THUMBNAIL_PREFIX

# AI 大模型配置示例
ai:
  # 当前使用的大模型提供方，可选值示例：openai、gemini、ollama、doubao 等
  provider: "openai"

  # OpenAI 配置（推荐优先使用配置文件，其次再用环境变量）
  openai:
    apiKey: "your_openai_api_key"               # 也可以通过环境变量 OPENAI_API_KEY 配置
    baseUrl: "https://api.openai.com"           # 可选，自建代理时可修改或留空
    model: "gpt-4.1-mini"                       # 可选，留空则使用默认 gpt-4.1-mini

  # Gemini 配置（当前代码中暂未实现 Provider，仅预留）
  gemini:
    apiKey: ""                                  # 预留字段
    baseUrl: ""                                 # 预留字段
    model: "gemini-3-flash-preview"             # 预留字段

  # 本地 Ollama 配置（已实现，使用前请先启动 Ollama 并拉取模型）
  ollama:
    host: "http://localhost:11434"             # Ollama 本地服务地址，默认 http://localhost:11434
    model: "gpt-oss:latest"                     # 使用的模型名称，如 gpt-oss:latest、llama3.2:latest

  # 豆包 / 字节系模型配置（当前代码中暂未实现 Provider，仅预留）
  doubao:
    apiKey: ""                                  # 预留字段
    baseUrl: ""                                 # 预留字段
    model: ""                                   # 运行时调用使用的 endpoint / model
    managementAccessKey: ""                     # 可选：用于动态拉取模型目录的管理侧 AK
    managementSecretKey: ""                     # 可选：用于动态拉取模型目录的管理侧 SK
    managementRegion: "cn-beijing"              # 可选：管理侧 Region
    projectName: ""                             # 可选：ARK 项目名，缺失时回退当前配置模型

# 注意事项:
# 1. **安全性**: api_token 具有账户权限,切勿提交到 Git 仓库
# 2. **获取 Account ID**: 在 Cloudflare Dashboard 右侧可以找到
# 3. **创建 API Token**: 
#    - 访问: https://dash.cloudflare.com/profile/api-tokens
#    - 创建 Token,权限需要包括: "D1:Edit"
# 4. **创建 D1 数据库**:
#    wrangler d1 create lastfm-scrobbler-db
#    # 复制返回的 database_id 到此处
# 5. **初始化数据库表**:
#    wrangler d1 execute lastfm-scrobbler-db --file=./cloudflare/d1_schema.sql
